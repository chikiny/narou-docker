# このファイルを .env にコピーして値を入れる（.env は Git に入れない）。

# 小説フォルダ（.narou / .narousetting / 小説データ があるフォルダ）
NOVEL_DIR=/home/chikiny/narou_rb/novel
# narou が変換した EPUB のコピー先。kfx-watcher がここで KFX に変換し、EPUB は 04_epub/ へ移す
CONVERT_OUTPUT_DIR=/home/chikiny/narou_rb/convert_output

# WEB UI を公開するアドレス。127.0.0.1 はサーバー内だけ。LAN から開くならサーバーの LAN IP（例: 192.168.0.36）
NAROU_BIND_ADDR=127.0.0.1

# 自動更新の時刻（HH:MM、空白区切りで複数可）
NAROU_UPDATE_TIMES=05:00
# WEB UI に Digest 認証を設定したら、自動更新用に同じユーザー名とパスワードを入れる
NAROU_WEB_USER=
NAROU_WEB_PASSWORD=

# ファイルの所有者（サーバーのユーザーの uid / gid。`id` で確認）
PUID=1000
PGID=1000

# Cloudflare の「Networking > Tunnels」でトンネルを作ったときに表示されるトークン
TUNNEL_TOKEN=
